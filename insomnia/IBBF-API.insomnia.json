    {
      "_id": "req_auth_refresh",
      "parentId": "fld_auth",
      "modified": 1757000000014,
      "created": 1757000000015,
      "url": "{{ _.base_url }}/auth/refresh",
      "name": "Refresh Token",
      "description": "Troca um `refreshToken` válido por um novo par accessToken/refreshToken. **Rotação:** o refresh token usado é revogado nesta chamada — cada um só pode ser usado uma vez. Não exige `Authorization`; o próprio refreshToken no corpo é a credencial.\n\n**Erros:** `AUTH.INVALID_REFRESH_TOKEN` (400) se o token não existir, estiver expirado, já tiver sido revogado, ou se o usuário dono não estiver mais ACTIVE.\n\nDepois de rodar, atualize `access_token` e `refresh_token` no ambiente com os novos valores.",
      "method": "POST",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"refreshToken\": \"{{ _.refresh_token }}\"\n}"
      },
      "parameters": [],
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        }
      ],
      "authentication": {},
      "metaSortKey": 3000,
