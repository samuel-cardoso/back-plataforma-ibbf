generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelo derivado do ERD "IBBF - Autenticação e Administração de Membros".
// Subdomínios: Autenticação (Role, User, RefreshToken) e Membros (Member,
// Family, Ministry, MemberMinistry).

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  level       Int
  description String?
  users       User[]

  @@map("roles")
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  passwordHash    String
  roleId          String
  status          UserStatus @default(ACTIVE)
  lastLoginAt     DateTime?
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())

  role                   Role                    @relation(fields: [roleId], references: [id])
  refreshTokens          RefreshToken[]
  passwordResetCodes     PasswordResetCode[]
  emailVerificationCodes EmailVerificationCode[]
  member                 Member?

  financeRole         UserFinanceRole?
  financeTransactions FinanceTransaction[]

  @@index([roleId])
  @@map("users")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_codes")
}

model EmailVerificationCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_codes")
}

model Member {
  id           String       @id @default(uuid())
  userId       String?      @unique
  familyId     String?
  familyRole   FamilyRole?
  fullName     String
  cpf          String?      @unique
  birthDate    DateTime     @db.Date
  phone        String?
  address      String?
  memberType   MemberType
  memberStatus MemberStatus
  joinedAt     DateTime     @db.Date
  baptized     Boolean      @default(false)

  user                User?                @relation(fields: [userId], references: [id])
  family              Family?              @relation(fields: [familyId], references: [id])
  ledMinistries       Ministry[]           @relation("MinistryLeader")
  memberMinistries    MemberMinistry[]
  financeTransactions FinanceTransaction[]

  @@index([familyId])
  @@map("members")
}

enum MemberType {
  MEMBER
  CONGREGANT
  VISITOR
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  TRANSFERRED
}

enum FamilyRole {
  HEAD
  SPOUSE
  CHILD
  OTHER
}

model Family {
  id        String   @id @default(uuid())
  name      String
  address   String?
  createdAt DateTime @default(now())

  members Member[]

  @@map("families")
}

model Ministry {
  id          String  @id @default(uuid())
  name        String  @unique
  leaderId    String?
  description String?

  leader           Member?          @relation("MinistryLeader", fields: [leaderId], references: [id])
  memberMinistries MemberMinistry[]

  @@index([leaderId])
  @@map("ministries")
}

model MemberMinistry {
  id         String       @id @default(uuid())
  memberId   String
  ministryId String
  role       MinistryRole
  joinedAt   DateTime     @db.Date

  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  ministry Ministry @relation(fields: [ministryId], references: [id], onDelete: Cascade)

  @@unique([memberId, ministryId])
  @@index([ministryId])
  @@map("member_ministries")
}

enum MinistryRole {
  LEADER
  MEMBER
}

// ===== Financeiro =====
// Papéis financeiros são ortogonais ao `Role.level`: hierarquia eclesiástica não implica
// acesso ao caixa (segregação de funções). Ver reports/Módulo financeiro para igrejas.md.

enum FinanceRole {
  TREASURER
  FISCAL_COUNCIL
  PASTOR_VIEWER
  COUNTER
}

model UserFinanceRole {
  id                      String      @id @default(uuid())
  userId                  String      @unique
  role                    FinanceRole
  /// Ver valores de contribuição por pessoa (dado sensível — LGPD art. 11). Desligado por padrão.
  canViewIndividualGiving Boolean     @default(false)
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_finance_roles")
}

model Fund {
  id         String   @id @default(uuid())
  name       String   @unique
  /// Fundo com restrição (ITG 2002): só pode ser gasto na finalidade e nunca fica negativo.
  restricted Boolean  @default(false)
  active     Boolean  @default(true)
  /// txid fixo usado no QR Pix estático deste fundo (ex.: MISSOES).
  pixTxid    String?  @unique
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  transactions FinanceTransaction[]

  @@map("funds")
}

enum FinanceCategoryType {
  INCOME
  EXPENSE
}

model FinanceCategory {
  id             String              @id @default(uuid())
  name           String
  type           FinanceCategoryType
  parentId       String?
  /// Código no plano de contas do contador, para exportação.
  accountingCode String?
  active         Boolean             @default(true)
  createdAt      DateTime            @default(now())

  parent       FinanceCategory?     @relation("FinanceCategoryTree", fields: [parentId], references: [id])
  children     FinanceCategory[]    @relation("FinanceCategoryTree")
  transactions FinanceTransaction[]

  @@unique([type, name])
  @@map("finance_categories")
}

enum CashAccountKind {
  CASH
  BANK
}

model CashAccount {
  id        String          @id @default(uuid())
  name      String          @unique
  kind      CashAccountKind
  bankName  String?
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())

  transactions FinanceTransaction[]

  @@map("cash_accounts")
}

enum FinanceTransactionKind {
  INCOME
  EXPENSE
  TRANSFER
  OPENING_BALANCE
}

enum PaymentMethod {
  CASH
  PIX
  CARD
  BANK_TRANSFER
  CHECK
  BOLETO
}

/// Livro-caixa imutável: nunca é editado nem apagado; correções são feitas por estorno
/// (nova linha com `reversesId`). `amountCents` é com sinal: positivo entra, negativo sai.
/// Saldo de fundo e de conta = SUM(amountCents) agrupado.
model FinanceTransaction {
  id                String                 @id @default(uuid())
  kind              FinanceTransactionKind
  date              DateTime               @db.Date
  amountCents       Int
  description       String?
  fundId            String
  cashAccountId     String
  categoryId        String?
  method            PaymentMethod?
  memberId          String?
  documentNumber    String?
  /// Agrupa as duas pernas de uma transferência (conta→conta ou fundo→fundo).
  transferGroupId   String?
  /// Referência da aprovação (ex.: ata) — exigida para transferência entre fundos.
  approvalReference String?
  reversesId        String?                @unique
  createdById       String
  createdAt         DateTime               @default(now())

  fund        Fund                @relation(fields: [fundId], references: [id])
  cashAccount CashAccount         @relation(fields: [cashAccountId], references: [id])
  category    FinanceCategory?    @relation(fields: [categoryId], references: [id])
  member      Member?             @relation(fields: [memberId], references: [id], onDelete: SetNull)
  reverses    FinanceTransaction? @relation("FinanceTransactionReversal", fields: [reversesId], references: [id])
  reversedBy  FinanceTransaction? @relation("FinanceTransactionReversal")
  createdBy   User                @relation(fields: [createdById], references: [id])

  @@index([date])
  @@index([fundId])
  @@index([cashAccountId])
  @@index([transferGroupId])
  @@map("finance_transactions")
}

enum FinancePeriodStatus {
  OPEN
  CLOSED
}

/// Mês contábil. Ausência de linha = mês aberto. Mês fechado bloqueia novos lançamentos com data nele.
model FinancePeriod {
  id           String              @id @default(uuid())
  year         Int
  month        Int
  status       FinancePeriodStatus @default(OPEN)
  closedById   String?
  closedAt     DateTime?
  reopenReason String?

  @@unique([year, month])
  @@map("finance_periods")
}

model FinanceAuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  data      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@map("finance_audit_logs")
}
